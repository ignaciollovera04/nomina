@{
    ViewData["Title"] = "Sistema de Nóminas";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="text-center mb-4">
                <i class="bi bi-cash-stack"></i> Sistema de Gestión de Nóminas
            </h1>
        </div>
    </div>

    <div class="row mt-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-file-person" style="font-size: 3rem; color: #ffc107;"></i>
                    <h3 class="mt-3">Gestionar Contratos</h3>
                    <p class="text-muted">Crear, editar y finalizar contratos laborales.</p>

                    <a asp-controller="Contrato" asp-action="Index" class="btn btn-warning btn-lg mt-3">
                        <i class="bi bi-folder-fill"></i> Gestionar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-calculator" style="font-size: 3rem; color: #0d6efd;"></i>
                    <h3 class="mt-3">Procesar Nómina</h3>
                    <p class="text-muted">Calcular y generar nóminas por periodo</p>

                    <a asp-controller="Nomina" asp-action="ProcesarNomina" class="btn btn-primary btn-lg mt-3">
                        <i class="bi bi-play-circle"></i> Procesar Ahora
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-text" style="font-size: 3rem; color: #198754;"></i>
                    <h3 class="mt-3">Consultar Nóminas</h3>
                    <p class="text-muted">Ver histórico de nóminas procesadas</p>

                    <a asp-controller="Nomina" asp-action="ListarNominas" class="btn btn-success btn-lg mt-3">
                        <i class="bi bi-search"></i> Ver Listado
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>