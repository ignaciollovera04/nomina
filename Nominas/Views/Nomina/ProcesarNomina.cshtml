<!-- Views/Nomina/ProcesarNomina.cshtml -->
@model List<Aplicacion.DTOs.PeriodoNominaDTO>
@{
    ViewData["Title"] = "Procesar Nómina por Periodo";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>
                <i class="bi bi-calculator-fill"></i> Procesar Nómina por Periodo
            </h2>
            <hr />
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

        @if (TempData["Detalles"] != null)
        {
            var detalles = System.Text.Json.JsonSerializer.Deserialize<List<Aplicacion.DTOs.DetalleNominaProcesadaDTO>>(TempData["Detalles"].ToString());
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5><i class="bi bi-list-check"></i> Resumen de Nóminas Procesadas</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>Sueldo Base</th>
                                <th>H. Extras</th>
                                <th>Total Ingresos</th>
                                <th>Descuentos</th>
                                <th class="text-end">Sueldo Neto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in detalles)
                            {
                                <tr>
                                    <td>@detalle.EmpleadoNombre</td>
                                    <td>S/ @detalle.SueldoBase.ToString("N2")</td>
                                    <td class="text-center">@detalle.HorasExtras h</td>
                                    <td>S/ @detalle.TotalIngresos.ToString("N2")</td>
                                    <td>S/ @detalle.TotalDescuentos.ToString("N2")</td>
                                    <td class="text-end"><strong>S/ @detalle.SueldoNeto.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

        @if (TempData["Errores"] != null)
        {
            var errores = System.Text.Json.JsonSerializer.Deserialize<List<string>>(TempData["Errores"].ToString());
            <div class="alert alert-warning">
                <h6><i class="bi bi-info-circle"></i> Detalles:</h6>
                <ul class="mb-0">
                    @foreach (var error in errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    }

    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-calendar-month"></i> Seleccionar Periodo</h4>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <form asp-action="Procesar" method="post">
                            <div class="mb-3">
                                <label for="periodoCodigo" class="form-label">Periodo de Nómina:</label>
                                <select name="periodoCodigo" id="periodoCodigo" class="form-select form-select-lg" required>
                                    <option value="">-- Seleccione un periodo --</option>
                                    @foreach (var periodo in Model)
                                    {
                                        <option value="@periodo.PeriodoCodigo">
                                            @periodo.PeriodoTipo - Del @periodo.PeriodoInicioStr al @periodo.PeriodoFinStr (@periodo.EstadoDescripcion)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i>
                                <strong>Importante:</strong> Al procesar, se calculará automáticamente la nómina de todos los empleados con contrato activo en el periodo seleccionado.
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-play-fill"></i> Procesar Nómina
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Volver
                                </a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> No hay periodos disponibles para procesar.
                        </div>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->