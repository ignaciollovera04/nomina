@model Dominio.Resultados.ContratoCalculoInfo
@{
    ViewData["Title"] = "Editar Contrato";

    // EPS más populares en Perú
    var listaEPS = new List<SelectListItem>
    {
        new SelectListItem { Text = "Rímac EPS", Value = "Rímac EPS" },
        new SelectListItem { Text = "Pacífico EPS", Value = "Pacífico EPS" },
        new SelectListItem { Text = "Sanitas EPS", Value = "Sanitas EPS" },
        new SelectListItem { Text = "La Positiva EPS", Value = "La Positiva EPS" },
        new SelectListItem { Text = "Mapfre EPS", Value = "Mapfre EPS" },
        new SelectListItem { Text = "Otro", Value = "Otro" }
    };

}

<div class="row">
    <div class="col-md-10 col-lg-8">
        <h2>
            <i class="bi bi-pencil-square"></i> @ViewData["Title"]
        </h2>
        <p class="text-muted">Modificando el contrato @Model.ContratoCodigo.</p>
        <hr />

        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="ContratoCodigo" />
            <input type="hidden" asp-for="ContratoEmpleadoCodigo" />

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            @if (ViewBag.Exito != null)
            {
                <div class="alert alert-success">@ViewBag.Exito</div>
            }

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <strong><i class="bi bi-person"></i> Datos del Empleado (No modificable)</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">DNI / Cód. Empleado</label>
                            <input type="text" asp-for="ContratoEmpleadoCodigo" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Empleado</label>
                            <input type="text" asp-for="EmpleadoNombre" class="form-control" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <strong><i class="bi bi-file-earmark-text-fill"></i> Datos del Contrato</strong>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="ContratoTipoContrato" class="form-label">Tipo de Contrato</label>
                            <select asp-for="ContratoTipoContrato" class="form-select" required>
                                <option value="INDEFINIDO">Indefinido</option>
                                <option value="PLAZO_FIJO">Plazo Fijo</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ContratoFechaInicio" class="form-label">Fecha de Inicio</label>
                            <input type="date" asp-for="ContratoFechaInicio" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ContratoFechaFin" class="form-label">Fecha de Fin (si es Plazo Fijo)</label>
                            <input type="date" asp-for="ContratoFechaFin" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ContratoSueldo" class="form-label">Sueldo Básico (S/)</label>
                            <input type="number" asp-for="ContratoSueldo" class="form-control" min="1130" step="0.01" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ContratoCargoCodigo" class="form-label">Cargo</label>
                            <select asp-for="ContratoCargoCodigo" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Cargos" required>
                                <option value="">-- Seleccionar Cargo --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ContratoAreaCodigo" class="form-label">Área</label>
                            <select asp-for="ContratoAreaCodigo" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Areas" required>
                                <option value="">-- Seleccionar Área --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ContratoRegimenPensionario" class="form-label">Régimen Pensionario</label>
                            <select asp-for="ContratoRegimenPensionario" class="form-select" required>
                                <option value="ONP">ONP</option>
                                <option value="AFP INTEGRA">AFP INTEGRA</option>
                                <option value="AFP PROFUTURO">AFP PROFUTURO</option>
                                <option value="AFP HABITAT">AFP HABITAT</option>
                                <option value="AFP PRIMA">AFP PRIMA</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ContratoTipoSeguro" class="form-label">Cobertura de Salud</label>
                            <select asp-for="ContratoTipoSeguro" class="form-select" required>
                                <option value="ESSALUD">ESSALUD</option>
                                <option value="EPS">EPS</option>
                                <option value="SIS">SIS</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ContratoEntidadEPS" class="form-label">Entidad EPS (Si aplica)</label>
                            <select asp-for="ContratoEntidadEPS"
                                    id="ContratoEntidadEPS"
                                    class="form-select"
                                    asp-items="listaEPS">
                                <option value="">-- Seleccionar EPS --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ContratoAsignacionFamiliar" class="form-label">Aplica Asignación Familiar</label>
                            <select asp-for="ContratoAsignacionFamiliar" class="form-select" required>
                                <option value="N">No</option>
                                <option value="S">Sí</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-end">
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-save"></i> Guardar Cambios
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const tipoContratoSelect = document.getElementById('ContratoTipoContrato');
            const fechaInicioInput = document.getElementById('ContratoFechaInicio');
            const fechaFinInput = document.getElementById('ContratoFechaFin');

                    const tipoSeguroSelect = document.getElementById('ContratoTipoSeguro');
        const entidadEPSSelect = document.getElementById('ContratoEntidadEPS');


                // NUEVA FUNCIÓN
        function manejarHabilitacionEPS() {
            const esEPS = tipoSeguroSelect.value === 'EPS';

            if (esEPS) {
                entidadEPSSelect.removeAttribute('disabled');
                entidadEPSSelect.setAttribute('required', 'required');
            } else {
                entidadEPSSelect.setAttribute('disabled', 'disabled');
                entidadEPSSelect.removeAttribute('required');
                entidadEPSSelect.value = '';
            }
        }

        // EVENTO
        tipoSeguroSelect.addEventListener('change', manejarHabilitacionEPS);

        // EJECUCIÓN INICIAL 

        setTimeout(manejarHabilitacionEPS, 20);


            // ----------------------------------------------------
            // 1. Lógica de Validación de Fechas (Mínimo 30 Días)
            // ----------------------------------------------------
            function actualizarMinimoFechaFin() {
                // Si el campo está deshabilitado por ser INDEFINIDO, no hacemos nada
                if (fechaFinInput.hasAttribute('disabled')) {
                    return;
                }

                const inicioValue = fechaInicioInput.value;

                if (inicioValue) {
                    const fechaInicio = new Date(inicioValue);

                    // Calculamos la fecha mínima (Inicio + 30 días)
                    const fechaMinFin = new Date(fechaInicio);
                    fechaMinFin.setDate(fechaInicio.getDate() + 30);

                    // Formateamos como YYYY-MM-DD
                    const year = fechaMinFin.getFullYear();
                    const month = String(fechaMinFin.getMonth() + 1).padStart(2, '0');
                    const day = String(fechaMinFin.getDate()).padStart(2, '0');
                    const formattedMinDate = `${year}-${month}-${day}`;

                    // Aplicar la restricción 'min'
                    fechaFinInput.setAttribute('min', formattedMinDate);

                    // Si la fecha actual en el campo de fin es menor al nuevo mínimo, la corregimos
                    if (fechaFinInput.value && fechaFinInput.value < formattedMinDate) {
                         fechaFinInput.value = formattedMinDate;
                    }
                } else {
                    fechaFinInput.removeAttribute('min');
                }
            }

            // ----------------------------------------------------
            // 2. Lógica de Habilitación/Deshabilitación (Plazo Fijo)
            // ----------------------------------------------------
            function manejarFechaFinHabilitacion() {
                const esPlazoFijo = tipoContratoSelect.value === 'PLAZO_FIJO';

                if (esPlazoFijo) {
                    // Habilita el campo y aplica el mínimo de 30 días
                    fechaFinInput.removeAttribute('disabled');
                    actualizarMinimoFechaFin();
                } else { // INDEFINIDO
                    // Deshabilita el campo y limpia el valor y la restricción
                    fechaFinInput.setAttribute('disabled', 'disabled');
                    fechaFinInput.value = '';
                    fechaFinInput.removeAttribute('min');
                }
            }


            // ----------------------------------------------------
            // 3. Event Listeners y Ejecución Inicial
            // ----------------------------------------------------
            tipoContratoSelect.addEventListener('change', manejarFechaFinHabilitacion);
            fechaInicioInput.addEventListener('change', actualizarMinimoFechaFin);

            // Ejecutar la lógica de habilitación al cargar (usamos setTimeout para asegurar la carga de valores iniciales de Razor)
            setTimeout(manejarFechaFinHabilitacion, 10);
        });
    </script>
}